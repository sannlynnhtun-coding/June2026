@model SaleCreateRequestModel
@{
    ViewData["Title"] = "Create Sale";
    List<ProductModel> products = ViewData["Products"] as List<ProductModel> ?? new List<ProductModel>();

    bool hasMessage = TempData["Message"] != null;
    bool isSuccess = false;
    string message = string.Empty;
    if (TempData["IsSuccess"] != null)
    {
        isSuccess = Convert.ToBoolean(TempData["IsSuccess"]);
        if (TempData["Message"] != null)
        {
            message = TempData["Message"]!.ToString()!;
        }
    }

    string defaultDateTime = Model.SaleDateTime == default
        ? DateTime.Now.ToString("yyyy-MM-ddTHH:mm")
        : Model.SaleDateTime.ToString("yyyy-MM-ddTHH:mm");
}

<h1>Create Sale</h1>

@if (hasMessage)
{
    <div class="alert @(isSuccess ? "alert-success" : "alert-danger")" role="alert">
        @message
    </div>
}

<form id="saleForm" action="/Sale/Save" method="post" class="mt-3">
    <div class="mb-3">
        <label class="form-label">Voucher No.</label>
        <input type="text" class="form-control" name="VoucherNo" value="@Model.VoucherNo" placeholder="V-0001">
    </div>
    <div class="mb-3">
        <label class="form-label">Sale Date Time</label>
        <input type="datetime-local" class="form-control" name="SaleDateTime" value="@defaultDateTime">
    </div>

    <h4>Sale Details</h4>
    <div id="saleDetailLines">
        <div class="row g-2 detail-line mb-2" data-index="0">
            <div class="col-md-5">
                <label class="form-label">Product</label>
                <select class="form-select" name="SaleDetails[0].ProductId">
                    <option value="0">-- select product --</option>
                    @foreach (var product in products)
                    {
                        <option value="@product.ProductId">@product.ProductName (@product.ProductCode)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Quantity</label>
                <input type="number" class="form-control" name="SaleDetails[0].Quantity" min="1" value="1">
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="button" class="btn btn-outline-danger remove-line w-100" disabled>Remove</button>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button type="button" id="addLine" class="btn btn-outline-secondary">Add Product Line</button>
        <button type="submit" class="btn btn-primary">Save Sale</button>
        <a href="/Sale" class="btn btn-outline-secondary">Back</a>
    </div>
</form>

@section scripts {
    <script>
        $(document).ready(function() {
            let canRefreshIndexes = true;

            function refreshIndexes() {
                if (!canRefreshIndexes) return;
                const lines = $('#saleDetailLines .detail-line');
                lines.each(function(index, line) {
                    $(line).find('[name]').each(function() {
                        const currentName = $(this).attr('name');
                        const nextName = currentName.replace(/\[\d+\]/, `[${index}]`);
                        $(this).attr('name', nextName);
                    });
                    $(line).find('.line-no').text(index + 1);
                    canRefreshIndexes = false;
                });
                canRefreshIndexes = true;
            }

            $('#addLine').click(function() {
                const clone = $('#saleDetailLines .detail-line:first').clone();
                clone.find('select').val('0');
                clone.find('input').val('1');
                clone.find('.remove-line').prop('disabled', false);
                $('#saleDetailLines').append(clone);
                refreshIndexes();
            });

            $(document).on('click', '.remove-line', function() {
                const lines = $('.detail-line');
                if (lines.length > 1) {
                    $(this).closest('.detail-line').remove();
                    refreshIndexes();
                }
            });

            $('#saleForm').on('submit', function () {
                refreshIndexes();
            });
        });
    </script>
}
