@model ProductListResponseModel
@{
    ViewData["Title"] = "Products";

    List<ProductModel> productCards = ViewData["ProductCards"] as List<ProductModel> ?? new List<ProductModel>();

    bool hasMessage = TempData["Message"] != null;
    bool isSuccess = false;
    string message = string.Empty;
    if (TempData["IsSuccess"] != null)
    {
        isSuccess = Convert.ToBoolean(TempData["IsSuccess"]);
        if (TempData["Message"] != null)
        {
            message = TempData["Message"]!.ToString()!;
        }
    }
}

<h1>Products</h1>

<a href="/Product/Create" class="btn btn-primary mb-3">Add Product</a>

@if (hasMessage)
{
    <div class="alert @(isSuccess ? "alert-success" : "alert-danger")" role="alert">
        @message
    </div>
}

<div class="row row-cols-1 row-cols-md-3 g-3 mb-4">
    @if (productCards.Count == 0)
    {
        <div class="col">
            <div class="text-muted">No product cards available yet.</div>
        </div>
    }
    else
    {
        foreach (var item in productCards)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@item.ProductName</h5>
                        <p class="card-text">Code: @item.ProductCode</p>
                        <p class="card-text">Price: @item.Price</p>
                        <p class="card-text">Qty: @item.Quantity</p>
                    </div>
                </div>
            </div>
        }
    }
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Action</th>
            <th>Product Id</th>
            <th>Product Code</th>
            <th>Product Name</th>
            <th>Price</th>
            <th>Quantity</th>
        </tr>
    </thead>
    <tbody>
        @if (Model?.Products == null || Model.Products.Count == 0)
        {
            <tr>
                <td colspan="6">No products found.</td>
            </tr>
        }
        else
        {
            foreach (ProductModel item in Model.Products)
            {
                <tr>
                    <td>
                        <a href="/Product/Edit/@item.ProductId" class="btn btn-sm btn-outline-warning">Edit</a>
                        <a href="/Product/Delete/@item.ProductId" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this product?');">Delete</a>
                    </td>
                    <td>@item.ProductId</td>
                    <td>@item.ProductCode</td>
                    <td>@item.ProductName</td>
                    <td>@item.Price</td>
                    <td>@item.Quantity</td>
                </tr>
            }
        }
    </tbody>
</table>
