@model UserListResponseModel

@{
    ViewData["Title"] = "User List";
    int count = 0;
}

<h1>User List</h1>

<a href="/User/Create" class="btn btn-primary">Add User</a>

<table class="table table-responsive">
    <thead>
        <tr>
            <th>Action</th>
            <th>No.</th>
            <th>User ID</th>
            <th>Username</th>
        </tr>
    </thead>
    <tbody>
        @foreach (UserModel item in Model.Users)
        {
            <tr>
                <td>
                    <a href="/User/Edit/@item.UserId" class="btn btn-sm btn-outline-warning">Edit</a>
                    <a href="/User/Delete/@item.UserId"
                       onclick="return confirm('Are you sure you want to delete this user?');"
                       class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
                <td>@(++count)</td>
                <td>@item.UserId</td>
                <td>@item.Username</td>
            </tr>
        }
    </tbody>
</table>